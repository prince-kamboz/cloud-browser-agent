# Copy to .env (git ignores it). Never commit real keys.

# --- OpenAI: used by the agent service (main model + vision model). Never sent to the browser.
OPENAI_API_KEY=
# Defaults shown; any OpenAI chat model works. The vision model must accept images.
MAIN_MODEL=gpt-6.1-sol
VISION_MODEL=gpt-6.1-sol

# --- Browserbase (the browser behind PROVIDER=browserbase), from the Browserbase dashboard
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: pin a region, e.g. us-west-2
# BROWSERBASE_REGION=

# --- Browser Use Cloud (the browser behind PROVIDER=browseruse), key starts with bu_
BROWSER_USE_API_KEY=
# Optional managed proxy country, e.g. us. Empty = no proxy (the API default is a US residential proxy)
# BROWSER_USE_PROXY_COUNTRY=

# --- Internal token between the control plane and the agent (compose has a dev default; set your own outside a laptop)
# INTERNAL_TOKEN=
